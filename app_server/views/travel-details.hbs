<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{#if trip.name}}{{trip.name}}{{else}}Trip Details{{/if}} - Travlr Getaways</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header }}

            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">

                            <h1>{{#if trip.name}}{{trip.name}}{{else}}Unnamed Trip{{/if}}</h1>

                            <img src="/images/{{trip.image}}"
                                 alt="{{trip.name}}"
                                 style="max-width: 400px;"
                                 onerror="this.src='/images/default.jpg'">

                            {{{trip.description}}}

                            <p><strong>Resort:</strong> {{#if trip.resort}}{{trip.resort}}{{else}}Not specified{{/if}}</p>

                            <p><strong>Length:</strong> {{#if trip.length}}{{trip.length}}{{else}}Not specified{{/if}}</p>

                            <p><strong>Category:</strong> {{#if trip.category}}{{trip.category}}{{else}}Not specified{{/if}}</p>

                            <p><strong>Price per person:</strong> 
                                {{#if trip.perPerson}}
                                    ${{trip.perPerson}}
                                {{else}}
                                    Not specified
                                {{/if}}
                            </p>

                            <p><a href="/travel">Back to Travel</a></p>

                        </div>
                    </div>
                </div>
            </div>

            {{> footer}}
        </div>
    </div>
</body>
</html>
