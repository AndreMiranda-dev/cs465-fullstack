<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Travel - Travlr Getaways</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header }}

            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">

                            <h1>Travel</h1>

                            <ul id="sites">
                                {{#each trips}}
                                <li>

                                    <!-- Image with fallback -->
                                    <a href="/travel/{{this.slug}}">
                                        <img src="/images/{{this.image}}"
                                             alt="{{this.name}}"
                                             onerror="this.src='/images/default.jpg'">
                                    </a>

                                    <!-- Trip name with fallback -->
                                    <h2>
                                        <a href="/travel/{{this.slug}}">
                                            {{#if this.name}}
                                                {{this.name}}
                                            {{else}}
                                                Unnamed Trip
                                            {{/if}}
                                        </a>
                                    </h2>

                                    <!-- Description with fallback -->
                                    {{#if this.description}}
                                        {{{this.description}}}
                                    {{else}}
                                        <p>No description available.</p>
                                    {{/if}}

                                </li>
                                {{/each}}
                            </ul>

                        </div>
                    </div>
                </div>
            </div>

            {{> footer}}
        </div>
    </div>
</body>
</html>
